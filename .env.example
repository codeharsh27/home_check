# ==========================================
# HomeCheck - Environment Variables
# ==========================================

# 1. Base Application URL (Optional)
# Used for OpenGraph social preview images and metadata.
# Defaults to "https://homecheck.in" if not set.
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 2. Supabase Configuration (Optional)
# Required only if you want cloud user authentication and multi-device sync.
# If omitted, HomeCheck operates seamlessly with client-side localStorage persistence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. AI / Intelligence Parsing APIs (Optional)
# Used for enhanced listing extraction & micro-market alternatives synthesis.
# If omitted, the engine automatically falls back to regex slug parsing & built-in locality data with 0 errors.
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
